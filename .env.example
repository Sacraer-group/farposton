# Generate once on the server, retain across restarts; never commit .env.
FLATS_SECRET_KEY=replace-with-random-server-secret
FLATS_TRIP_SESSION_BUDGET=100
FLATS_TRIP_GLOBAL_BUDGET=1000
# Browser-visible Map Tiles API key for MapGL; restrict allowed origins in 2GIS.
# Keep this separate from the server-only routing key in FLATS_2GIS_KEY_FILE.
FLATS_2GIS_MAP_KEY=
# Optional OpenAI-compatible chat provider; the server appends /chat/completions.
# Leave unset to use the explicitly labelled evidence-based retrieval mode.
FLATS_LLM_BASE_URL=
FLATS_LLM_MODEL=
FLATS_LLM_API_KEY=
