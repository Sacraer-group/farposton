# Local demonstration profile. Keep secrets in the private .env file.
DEPLOYMENT_PROFILE=local
WEB_DEMO_NO_AUTH=1
WEB_HOST=127.0.0.1
WEB_PORT=8446
WEB_USERS_JSON=[]
WEB_SECRET_KEY=<generate-with-python-m-web.auth---secret>
SESSION_SECURE_COOKIE=1
PUBLIC_HTTPS=1
ALLOWED_HOSTS=
TRUSTED_PROXY_IPS=127.0.0.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ALLOW_CLIENT_DATA=0
PROGNOZ_1C_INGEST=0
PROGNOZ_1C_WRITE=0
PROGNOZ_DB_PATH=/opt/product/data/forecast/prognoz.duckdb
WEB_DB_SNAPSHOT=/opt/product/data/forecast/prognoz_web.duckdb
APP_OUTPUT_ROOT=/opt/product/data/forecast/output
WEB_OUTPUT_ROOT=/opt/product/data/forecast/output
WEB_FORECAST_LOG_DIR=/opt/product/data/forecast/output/forecast_log
WEB_RELEASE_ROOT=/opt/product/data/forecast/output/releases
WEB_EDITS_DB=/opt/product/data/forecast/web_edits.sqlite
PROGNOZ_CONFIG_DIR=/opt/product/data/forecast/config
PROGNOZ_ML_MODEL_DIR=/opt/product/data/forecast/models
PROGNOZ_ENGINE=ml
LOG_FILE=/opt/product/data/forecast/logs/web.log
